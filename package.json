{
  "name": "hospital-management-system",
  "private": true,
  "scripts": {
    "start": "npm --prefix frontend start",
    "start:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "dev": "npm --prefix frontend run dev",
    "clean": "cd backend && .\\mvnw.cmd clean",
    "build": "npm --prefix frontend run build && cd backend && .\\mvnw.cmd clean package -DskipTests",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && .\\mvnw.cmd clean package -DskipTests",
    "format": "npm --prefix frontend run format",
    "format:frontend": "npm --prefix frontend run format",
    "test": "npm --prefix frontend test && cd backend && .\\mvnw.cmd test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "cd backend && .\\mvnw.cmd test"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
